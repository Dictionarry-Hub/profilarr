{
	"name": "profilarr",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^24",
		"pnpm": "^11"
	},
	"scripts": {
		"dev": "node scripts/dev.ts",
		"build": "APP_BASE_PATH=./dist/build vite build && deno compile --no-lock --node-modules-dir=none --exclude-unused-npm --no-check --allow-all --target x86_64-unknown-linux-gnu --output dist/build/profilarr dist/build/mod.ts",
		"sync": "svelte-kit sync",
		"format": "prettier --write .",
		"lint": "prettier --check . && pnpm run lint:eslint && pnpm run lint:toolchain && pnpm run lint:api-permissions",
		"lint:eslint": "eslint .",
		"lint:toolchain": "node scripts/lint/toolchain.ts",
		"lint:api-permissions": "node scripts/lint/apiPermissions.ts",
		"check": "pnpm run check:client && pnpm run check:tests",
		"check:client": "NODE_ENV=development svelte-check --tsconfig ./tsconfig.json",
		"check:tests": "tsc -p tests/unit/tsconfig.json && tsc --noEmit -p tests/flows/tsconfig.json",
		"test:unit": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:flows": "node scripts/flows/run.ts",
		"fixtures:update": "node scripts/flows/fixtures-update.ts",
		"fixtures:arr": "node scripts/flows/arr-record.ts",
		"flows:timings": "node scripts/flows/timings.ts",
		"generate:api-types": "node scripts/generate/openapi-json.ts && openapi-typescript docs/api/v1/openapi.yaml -o src/lib/api/v1.d.ts && prettier --write src/lib/api/v1.d.ts src/lib/api/v1.openapi.json",
		"generate:pcd-types": "node scripts/generate/pcd-types.ts",
		"scan:zap": "node tests/scan/zap/scan.ts",
		"scan:semgrep": "node tests/scan/semgrep/scan.ts",
		"release:dry": "node scripts/release.ts dry",
		"release:scan": "node scripts/release.ts scan",
		"release": "node scripts/release.ts tag"
	},
	"imports": {
		"#server/*": "./src/lib/server/*",
		"#db/*": "./src/lib/server/db/*",
		"#utils/*": "./src/lib/server/utils/*",
		"#logger/*": "./src/lib/server/utils/logger/*",
		"#arr/*": "./src/lib/server/utils/arr/*",
		"#pcd/*": "./src/lib/server/pcd/*",
		"#entities/*": "./src/lib/server/pcd/entities/*",
		"#notifications/*": "./src/lib/server/notifications/*",
		"#client/*": "./src/lib/client/*",
		"#ui/*": "./src/lib/client/ui/*",
		"#stores/*": "./src/lib/client/stores/*",
		"#shared/*": "./src/lib/shared/*",
		"#api/*": "./src/lib/api/*",
		"#routes/*": "./src/routes/*",
		"#tests/*": "./tests/*",
		"#flows/*": "./tests/flows/*",
		"#integration/*": "./tests/integration/*",
		"#scripts/*": "./scripts/*"
	},
	"dependencies": {
		"@lucide/svelte": "1.61.0",
		"@sveltejs/kit": "3.1.0",
		"bcryptjs": "3.0.3",
		"croner": "10.0.1",
		"jose": "6.2.13",
		"js-yaml": "5.5.0",
		"kysely": "0.27.6",
		"marked": "18.1.1",
		"simple-icons": "16.35.0",
		"svelte": "5.57.2"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.19.2",
		"esbuild": "0.28.2",
		"eslint": "10.13.0",
		"eslint-plugin-svelte": "3.23.1",
		"openapi-typescript": "7.13.0",
		"playwright": "1.64.1",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte-check": "4.7.7",
		"svelte-eslint-parser": "1.9.0",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	}
}
