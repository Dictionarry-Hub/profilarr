{
	"nodeModulesDir": "auto",
	"minimumDependencyAge": "P7D",
	"imports": {
		// Path aliases
		"$lib/": "./src/lib/",
		"$api/": "./src/lib/api/",
		"$config": "./src/lib/server/utils/config/config.ts",
		"$logger/": "./src/lib/server/utils/logger/",
		"$shared/": "./src/lib/shared/",
		"$stores/": "./src/lib/client/stores/",
		"$ui/": "./src/lib/client/ui/",
		"$assets/": "./src/lib/client/assets/",
		"$alerts/": "./src/lib/client/alerts/",
		"$server/": "./src/server/",
		"$db/": "./src/lib/server/db/",
		"$jobs/": "./src/lib/server/jobs/",
		"$drift/": "./src/lib/server/drift/",
		"$pcd/": "./src/lib/server/pcd/",
		"$arr/": "./src/lib/server/utils/arr/",
		"$http/": "./src/lib/server/utils/http/",
		"$utils/": "./src/lib/server/utils/",
		"$notifications/": "./src/lib/server/notifications/",
		"$announcements/": "./src/lib/server/announcements/",
		"$sync/": "./src/lib/server/sync/",
		"$cache/": "./src/lib/server/utils/cache/",
		"$auth/": "./src/lib/server/utils/auth/",
		"$test-harness/": "./tests/integration/harness/",

		// Runtime
		"@db/sqlite": "npm:@jsr/db__sqlite@0.12.0",
		"@felix/bcrypt": "jsr:@felix/bcrypt@^1.0.8",
		"@lucide/svelte": "npm:@lucide/svelte@^1.22.0",
		"@soapbox/kysely-deno-sqlite": "jsr:@soapbox/kysely-deno-sqlite@^2.2.0",
		"@std/yaml": "jsr:@std/yaml@^1.1.1",
		"@sveltejs/kit": "npm:@sveltejs/kit@^2.69.2",
		"croner": "npm:croner@^10.0.1",
		"jose": "npm:jose@^6.2.3",
		"kysely": "npm:kysely@0.27.6",
		"marked": "npm:marked@^18.0.5",
		"simple-icons": "npm:simple-icons@^16.24.1",
		"svelte": "npm:svelte@^5.56.4",

		// Tooling
		"@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.2",
		"@playwright/test": "npm:@playwright/test@^1.61.1",
		"@std/assert": "jsr:@std/assert@^1.0.19",
		"@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.1.2",
		"@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.1",
		"@types/deno": "npm:@types/deno@^2.7.0",
		"@types/node": "npm:@types/node@^22.20.0",
		"esbuild": "npm:esbuild@^0.28.1",
		"openapi-typescript": "npm:openapi-typescript@^7.13.0",
		"playwright": "npm:playwright@^1.61.1",
		"prettier": "npm:prettier@3.8.4",
		"prettier-plugin-svelte": "npm:prettier-plugin-svelte@^4.1.1",
		"prettier-plugin-tailwindcss": "npm:prettier-plugin-tailwindcss@^0.8.0",
		"svelte-check": "npm:svelte-check@^4.7.2",
		"tailwindcss": "npm:tailwindcss@^4.3.1",
		"typescript": "npm:typescript@^6.0.3",
		"vite": "npm:vite@^8.1.4"
	},
	"tasks": {
		"dev": "deno run -A scripts/dev.ts",
		"dev:no-auth": "AUTH=off deno run -A scripts/dev.ts",
		"dev:bulletin": "deno run -A scripts/serve-dev-bulletin.ts",
		"preview:proxy": "deno run -A scripts/preview-proxy.ts",
		"preview:proxy:tls": "deno run -A scripts/preview-proxy.ts --tls",
		"dev:server": "DENO_ENV=development PORT=6969 HOST=0.0.0.0 APP_BASE_PATH=./dist/dev PARSER_HOST=localhost PARSER_PORT=5000 VITE_PLATFORM=linux-amd64 VITE_CHANNEL=dev deno run -A npm:vite dev",
		"dev:server:no-auth": "AUTH=off DENO_ENV=development PORT=6969 HOST=0.0.0.0 APP_BASE_PATH=./dist/dev PARSER_HOST=localhost PARSER_PORT=5000 VITE_PLATFORM=linux-amd64 VITE_CHANNEL=dev deno run -A npm:vite dev",
		"dev:parser": "cd src/services/parser && dotnet watch run --urls http://localhost:5000",
		"build": "APP_BASE_PATH=./dist/build deno run -A npm:vite build && deno compile --no-check --allow-net --allow-read --allow-write --allow-env --allow-ffi --allow-run --allow-sys --target x86_64-unknown-linux-gnu --output dist/build/profilarr dist/build/mod.ts",
		"preview": "PORT=6869 HOST=0.0.0.0 APP_BASE_PATH=./dist/dev PARSER_HOST=localhost PARSER_PORT=5000 ./dist/build/profilarr",
		"clean:dev": "rm -rf dist/dev",
		"format": "prettier --write .",
		"lint": "prettier --check . && deno lint && deno task lint:toolchain && deno task lint:ui && deno task lint:crypto && deno task lint:datetime && deno task lint:clipboard && deno task lint:page-meta",
		"lint:toolchain": "deno run --allow-read scripts/lint/toolchain.ts",
		"lint:ui": "deno run --allow-read --allow-env scripts/lint/ui.ts",
		"lint:crypto": "deno run --allow-read --allow-env scripts/lint/crypto.ts",
		"lint:datetime": "deno run --allow-read --allow-env scripts/lint/datetime.ts",
		"lint:clipboard": "deno run --allow-read --allow-env scripts/lint/clipboard.ts",
		"lint:page-meta": "deno run --allow-read --allow-env scripts/lint/pageMeta.ts",
		"check": "deno task check:server && deno task check:client",
		"check:server": "deno check --quiet src/lib/server/**/*.ts",
		"check:client": "NODE_ENV=development deno run -A npm:svelte-check --tsconfig ./tsconfig.json",
		"test": "deno run -A tests/runner.ts",
		"release:dry": "deno run --allow-run=git-cliff scripts/release.ts dry",
		"release:scan": "deno run --allow-run=docker,trivy scripts/release.ts scan",
		"release": "deno run --allow-run=git,docker,trivy scripts/release.ts tag",
		"generate:api-json": "deno run --allow-read=docs/api/v1 --allow-write=src/lib/api/v1.openapi.json scripts/generate-openapi-json.ts",
		"generate:api-types": "deno task generate:api-json && deno run -A npm:openapi-typescript docs/api/v1/openapi.yaml -o src/lib/api/v1.d.ts && prettier --write src/lib/api/v1.d.ts src/lib/api/v1.openapi.json",
		"generate:pcd-types": "deno run -A scripts/generate-pcd-types.ts",
		"stats": "deno run --allow-read --allow-env scripts/stats.ts",
		"webhook": "deno run --allow-net scripts/webhook-listener.ts",
		"docker:build": "docker compose -f compose.yml -f compose.dev.yml build",
		"docker:up": "docker compose -f compose.yml -f compose.dev.yml up --build"
	},
	"compilerOptions": {
		"lib": ["deno.window", "dom"],
		"strict": true
	},
	"exclude": ["dist/", "node_modules/", "src/routes/"],
	"fmt": {
		"exclude": ["dist/", "node_modules/"],
		"indentWidth": 2,
		"useTabs": false
	},
	"lint": {
		"exclude": ["dist/", "node_modules/", "tests/", ".svelte-kit/", "src/adapter/"],
		"rules": {
			"include": ["no-eval", "no-throw-literal"],
			"exclude": ["no-window", "no-window-prefix", "require-await"]
		}
	}
}
