{
	"nodeModulesDir": "auto",
	"minimumDependencyAge": "P7D",
	"imports": {
		// Runtime
		"@lucide/svelte": "npm:@lucide/svelte@^1.61.0",
		"@sveltejs/kit": "npm:@sveltejs/kit@^3.1.0",
		"bcryptjs": "npm:bcryptjs@^3.0.3",
		"croner": "npm:croner@^10.0.1",
		"jose": "npm:jose@^6.2.13",
		"js-yaml": "npm:js-yaml@^5.5.0",
		"kysely": "npm:kysely@0.27.6",
		"marked": "npm:marked@^18.1.1",
		"simple-icons": "npm:simple-icons@^16.35.0",
		"svelte": "npm:svelte@^5.57.2",

		// Tooling
		"@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.4",
		"@eslint/js": "npm:@eslint/js@^10.0.1",
		"@playwright/test": "npm:@playwright/test@^1.64.1",
		"@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.3.1",
		"@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
		"@types/deno": "npm:@types/deno@^2.7.0",
		"@types/node": "npm:@types/node@^24.19.2",
		"esbuild": "npm:esbuild@^0.28.2",
		"eslint": "npm:eslint@^10.13.0",
		"eslint-plugin-svelte": "npm:eslint-plugin-svelte@^3.23.1",
		"openapi-typescript": "npm:openapi-typescript@^7.13.0",
		"playwright": "npm:playwright@^1.64.1",
		"prettier": "npm:prettier@3.9.10",
		"prettier-plugin-svelte": "npm:prettier-plugin-svelte@^4.1.1",
		"prettier-plugin-tailwindcss": "npm:prettier-plugin-tailwindcss@^0.8.1",
		"svelte-eslint-parser": "npm:svelte-eslint-parser@^1.9.0",
		"svelte-check": "npm:svelte-check@^4.7.7",
		"tailwindcss": "npm:tailwindcss@^4.3.3",
		"typescript": "npm:typescript@6.0.3",
		"typescript-eslint": "npm:typescript-eslint@^8.72.0",
		"vite": "npm:vite@^8.3.5",
		"vitest": "npm:vitest@^5.0.5"
	},
	"tasks": {
		"dev": "node scripts/dev.ts",
		"build": "APP_BASE_PATH=./dist/build deno run -A vite build && deno compile --node-modules-dir=none --exclude-unused-npm --no-check --allow-all --target x86_64-unknown-linux-gnu --output dist/build/profilarr dist/build/mod.ts",
		"preview": "PORT=6869 HOST=0.0.0.0 APP_BASE_PATH=./dist/dev PARSER_HOST=localhost PARSER_PORT=5000 ./dist/build/profilarr",
		"clean:dev": "rm -rf dist/dev",
		"format": "prettier --write .",
		"lint": "prettier --check . && deno task lint:eslint && deno task lint:toolchain && deno task lint:api-permissions",
		"lint:eslint": "node node_modules/eslint/bin/eslint.js .",
		"lint:toolchain": "node scripts/lint/toolchain.ts",
		"lint:api-permissions": "node scripts/lint/apiPermissions.ts",
		"check": "deno task check:client && deno task check:tests",
		"check:client": "NODE_ENV=development deno run -A svelte-check --tsconfig ./tsconfig.json",
		"check:tests": "node node_modules/typescript/bin/tsc -p tests/unit/tsconfig.json",
		"test:unit": "node node_modules/vitest/vitest.mjs run",
		"test:integration": "node node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
		"test:flows": "node scripts/flows/run.ts",
		"scan:zap": "node tests/scan/zap/scan.ts",
		"scan:semgrep": "node tests/scan/semgrep/scan.ts",
		"release:dry": "node scripts/release.ts dry",
		"release:scan": "node scripts/release.ts scan",
		"release": "node scripts/release.ts tag",
		"generate:api-json": "node scripts/generate/openapi-json.ts",
		"generate:api-types": "deno task generate:api-json && deno run -A openapi-typescript docs/api/v1/openapi.yaml -o src/lib/api/v1.d.ts && prettier --write src/lib/api/v1.d.ts src/lib/api/v1.openapi.json",
		"generate:pcd-types": "node scripts/generate/pcd-types.ts",
		"fixtures:update": "node scripts/flows/fixtures-update.ts",
		"fixtures:arr": "node scripts/flows/arr-record.ts",
		"flows:timings": "node scripts/flows/timings.ts"
	},
	"compilerOptions": {
		"lib": ["deno.window", "dom"],
		"strict": true
	},
	"exclude": ["dist/", "node_modules/", "src/routes/"],
	"fmt": {
		"exclude": ["dist/", "node_modules/"],
		"indentWidth": 2,
		"useTabs": false
	}
}
